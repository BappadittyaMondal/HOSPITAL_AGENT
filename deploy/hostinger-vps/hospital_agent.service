[Unit]
Description=HOSPITAL_AGENT Core Clinical API & Deterministic Rule Engine
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/hospital_agent/services/core-api
Environment="PATH=/opt/hospital_agent/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="HOSPITAL_ENV=production"
Environment="PYTHONPATH=/opt/hospital_agent/services/core-api"
ExecStart=/opt/hospital_agent/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 4 --proxy-headers
Restart=always
RestartSec=5s
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
