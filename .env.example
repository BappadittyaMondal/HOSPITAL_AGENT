# ==============================================================================
# HOSPITAL PLATFORM — ZERO-TRUST ENVIRONMENT CONFIGURATION
# Copy this file to .env and replace default values before production deployment
# ==============================================================================

# System Environment
ENVIRONMENT=development
LOG_LEVEL=debug
APP_SECRET=change_me_to_a_minimum_64_character_cryptographically_secure_random_string

# PostgreSQL Database (TimescaleDB + pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hospital_main
POSTGRES_USER=hospital_admin
POSTGRES_PASSWORD=hospital_secure_password_2026
POSTGRES_SSLMODE=disable
POSTGRES_MAX_OPEN_CONNS=50
POSTGRES_MAX_IDLE_CONNS=10

# Redis Cache & Session
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_pass_2026
REDIS_DB=0

# Event Broker (Redpanda / Kafka)
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=hospital-core
KAFKA_GROUP_ID=hospital-workers

# Object Storage (MinIO S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=hospital_s3_admin
MINIO_ROOT_PASSWORD=hospital_s3_secret_2026
MINIO_BUCKET_CLINICAL_MEDIA=hospital-clinical-media
MINIO_BUCKET_AUDIT_LOGS=hospital-audit-vault
MINIO_USE_SSL=false

# Orthanc PACS
ORTHANC_HOST=localhost
ORTHANC_PORT=8042
ORTHANC_DICOM_PORT=4242
ORTHANC_USERNAME=pacsadmin
ORTHANC_PASSWORD=pacs_secure_2026

# Microservice Ports
CORE_API_PORT=8080
SAFETY_ENGINE_PORT=50051
AI_ORCHESTRATOR_PORT=8000
WEB_CLIENT_PORT=3000

# AI Model Serving & Token Governance
AI_PRIMARY_PROVIDER=local
LOCAL_INFERENCE_ENDPOINT=http://localhost:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MONTHLY_DEPARTMENT_TOKEN_BUDGET=5000000

# India Statutory Integration Endpoints (Sandbox)
ABDM_BASE_URL=https://dev.abdm.gov.in
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
NHCX_GATEWAY_URL=https://gateway.sandbox.nhcx.gov.in
IDSP_REPORTING_ENABLED=true
